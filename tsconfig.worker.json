{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "WebWorker"], "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true, "types": ["@cloudflare/workers-types"],
    "noEmit": true, "composite": true, "tsBuildInfoFile": "./node_modules/.tmp/worker.tsbuildinfo"
  },
  "include": ["worker", "tests"]
}
